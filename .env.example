# Zikos Configuration
# Copy this file to .env and adjust values for your setup

# ============================================================================
# LLM Configuration
# ============================================================================
# NOTE: These variables override default constants. Don't edit those unless
# you know what you're doing

# --- Cloud backends (litellm) -----------------------------------------------
# Set these three to use a cloud provider instead of a local model.
# Provider: openai | anthropic | gemini | mistral | ... (litellm conventions)
LLM_PROVIDER=
# API key forwarded to litellm; alternatively set the provider-specific env
# var (OPENAI_API_KEY, ANTHROPIC_API_KEY, ...) and leave this blank
LLM_API_KEY=
# litellm model string, e.g. gpt-4o, claude-sonnet-4-6, gemini/gemini-2.0-flash
LLM_MODEL_NAME=

# --- Local backends ----------------------------------------------------------
# Path to a GGUF file (llama-cpp-python) or Transformers model directory
LLM_MODEL_PATH=

# LLM backend: auto, llama_cpp, or transformers
# auto will detect based on model file extension
LLM_BACKEND=auto

# Tool format: auto (detect from model), qwen (<tool_call> JSON), simplified (<tool> key:value), native (API only)
LLM_TOOL_FORMAT=auto

# Context window size (auto-detected from model if not set)
# Recommended: 32768 for 8GB VRAM, 65536 for 16-24GB, 131072 for 40GB+
LLM_N_CTX=

# Number of GPU layers (-1=auto, 0=CPU only)
# Use 0 for CPU-only, -1 for automatic detection
LLM_N_GPU_LAYERS=-1

# Sampling temperature (0.0-1.0, higher = more creative)
LLM_TEMPERATURE=0.7

# Top-p sampling (0.0-1.0, nucleus sampling)
LLM_TOP_P=0.9

# Top-k sampling (number of highest-probability tokens considered)
LLM_TOP_K=40

# Maximum tokens the model may spend in thinking blocks (0 = unlimited)
LLM_MAX_THINKING_TOKENS=0

# System Prompt KV Cache (optional, llama-cpp-python only)
# Path to pre-computed system prompt KV cache file
# If set and file doesn't exist, it will be auto-generated on startup
# Can be generated manually with: python scripts/generate_system_prompt_cache.py
SYSTEM_PROMPT_CACHE_PATH=

# ============================================================================
# API Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# ============================================================================
# MCP Server
# ============================================================================
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8001

# ============================================================================
# Storage Paths
# ============================================================================
AUDIO_STORAGE_PATH=audio_storage
MIDI_STORAGE_PATH=midi_storage
NOTATION_STORAGE_PATH=notation_storage

# Per-user settings file
USER_SETTINGS_PATH=data/user_settings.json

# SoundFont for MIDI-to-audio synthesis (FluidSynth)
# Leave blank to auto-detect via fluidsynth's built-in default, SOUNDFONT env var,
# or ~/.fluidsynth/default_sound_font.sf2 (midi2audio convention).
# Install a soundfont: 'soundfont-fluid' (Arch), 'fluid-soundfont-gm' (Debian/Ubuntu),
# then either set this or symlink to ~/.fluidsynth/default_sound_font.sf2
# SOUNDFONT_PATH=/path/to/FluidR3_GM.sf2

# ============================================================================
# Debug
# ============================================================================
# Enable verbose tool calling logs
DEBUG_TOOL_CALLS=false
